{
  "name": "csproj-auto-include",
  "displayName": "CSProj Auto Include",
  "description": "Automates the tedious process of manually maintaining your .csproj files",
  "publisher": "filipe-cauduro",
  "version": "1.0.4",
  "license": "MIT",
  "author": {
    "name": "filipe-cauduro",
    "url": "https://github.com/filipe-cauduro"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/filipe-cauduro/csproj-auto-include.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./build/extension.js",
  "contributes": {
    "configuration": {
      "title": "CSProj Auto Include",
      "properties": {
        "csproj-auto-include.fileMappings": {
          "type": "object",
          "default": {},
          "description": "Mapping of file extensions to the XML tag name used in the .csproj file. Example: {\".cs\": \"Compile\", \".xaml\": \"Page\"}"
        },
        "csproj-auto-include.blocklist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns for files to ignore, matched against paths relative to the closest .csproj and workspace folder, as well as absolute paths. Examples: 'obj/**', '**/suggestion/*/trade.cs', '*.test.cs'."
        },
        "csproj-auto-include.showNotifications": {
          "type": "boolean",
          "default": false,
          "description": "Whether to show popup notifications when the .csproj is successfully updated."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "compile:tests": "tsc -p tests/tsconfig.json",
    "pretest": "yarn compile && yarn compile:tests",
    "test": "mocha \".vscode-test/compiled/tests/unit/**/*.test.js\"",
    "test:integration": "yarn compile && yarn compile:tests && node .vscode-test/compiled/tests/run-integration.js",
    "test:stress": "yarn compile && yarn compile:tests && node .vscode-test/compiled/tests/run-integration.js --stress",
    "test:package": "yarn compile && yarn compile:tests && mocha --timeout 30000 .vscode-test/compiled/tests/package.test.js",
    "lint": "eslint src --ext ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "style": "yarn lint && yarn format",
    "package": "mkdir -p dist && vsce package --allow-missing-repository --skip-license -o dist/"
  },
  "devDependencies": {
    "@types/minimatch": "^6.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^18.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.x",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "mocha": "^10.8.2",
    "prettier": "^3.9.6",
    "typescript": "^5.x"
  },
  "dependencies": {
    "minimatch": "^10.2.6"
  }
}
