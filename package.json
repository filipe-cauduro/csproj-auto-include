{
  "name": "csproj-auto-include",
  "displayName": "CSProj Auto Include",
  "description": "Automatically import newly created files into a .csproj file",
  "version": "0.0.2",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./build/extension.js",
  "contributes": {
    "configuration": {
      "title": "CSProj Auto Include",
      "properties": {
        "csproj-auto-include.fileMappings": {
          "type": "object",
          "default": {
            ".cs": "Compile"
          },
          "description": "Mapping of file extensions to the XML tag name used in the .csproj file. Example: {\".cs\": \"Compile\", \".xaml\": \"Page\"}"
        },
        "csproj-auto-include.showNotifications": {
          "type": "boolean",
          "default": false,
          "description": "Whether to show popup notifications when the .csproj is successfully updated."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn compile && yarn lint",
    "lint": "eslint src --ext ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "style": "yarn lint && yarn format",
    "package": "vsce package --allow-missing-repository --skip-license -o dist"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.x",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "typescript": "^5.x"
  },
  "dependencies": {}
}